# ============================================================
# Ruchi — shared environment config
# Copy this file to .env in the project root and fill in real values.
# Loaded by both backend/app.py (Flask) and chatbot-service/main.py (FastAPI)
# ============================================================

# ---- Backend · Flask (backend/) ----
# DATABASE_URL intentionally omitted — config.py's default is an absolute
# path to backend/instance/ruchi.db, which works regardless of which
# directory the process is started from. Only set this if pointing at a
# real database server (e.g. Postgres) instead of the default SQLite file.
SECRET_KEY=change-this-in-production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
BACKEND_PORT=5000

# ---- Chatbot service · FastAPI (chatbot-service/) ----
HF_TOKEN=your_huggingface_token_here
HOST=0.0.0.0
CHATBOT_PORT=8000
